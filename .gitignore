# 可移交的初始化数据属于部署输入，允许纳入版本库。
!seed-data/uploads.tar.gz
!seed-data/legacy-uploads.tar.gz

# 运行时产物：nohup 日志 / pid / 编辑器临时文件
*.log
nohup.out
*.pid
*.swp
*~

samples/converted/
samples/poc-screenshots/
*.pdf
server/uploads/
# 加装的字体文件（可能为专有字体，如微软仿宋/楷体）——本地用，不入库；保留 fonts/README.md
fonts/*.ttf
fonts/*.ttc
fonts/*.otf
fonts/*.TTF
fonts/*.TTC
fonts/*.OTF
