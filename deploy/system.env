# 递归智能报告系统唯一部署配置
# 修改此文件后执行 ./system.sh mock 或 ./system.sh server 即可应用。

# 镜像和端口
APP_IMAGE=cdr-report:latest
POSTGRES_IMAGE=postgres:16-bookworm
DOCKER_PLATFORM=linux/amd64
HTTP_PORT=5173
DOCKER_SUBNET=10.250.241.0/24

# 数据库。mock 可直接使用默认值；server 部署前必须修改 DB_PASSWORD。
DB_NAME=cdr_report
DB_USER=cdr
DB_PASSWORD=cdr-local-demo
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000

# 只有执行 ./system.sh snapshot 时使用：旧开发数据库及上传目录。
# 若本机 PostgreSQL 需要密码，在导出前临时填写，导出后清空再提交。
SNAPSHOT_DB_HOST=localhost
SNAPSHOT_DB_PORT=5432
SNAPSHOT_DB_NAME=cdr_demo
SNAPSHOT_DB_USER=trish
SNAPSHOT_DB_PASSWORD=
SNAPSHOT_UPLOADS_DIR=../data
SNAPSHOT_LEGACY_UPLOADS_DIR=server/uploads

# 新建空数据库卷时是否恢复 seed-data/cdr_demo.dump。
# 1=带入本次移交的全部模板、订单、录入和报告；0=建立全新空库。
LOAD_SNAPSHOT_ON_EMPTY=1

# mock 模式：不连接 OA/SOAP，允许本地演示登录。
MOCK_PUBLIC_BASE_URL=http://127.0.0.1:5173
MOCK_LOCAL_ADMIN=admin
MOCK_LOCAL_ADMIN_PASSWORD=123

# server 模式：填写内网实际地址。本文件是 mock/server 切换的唯一配置入口。
SERVER_PUBLIC_BASE_URL=http://172.19.10.12:5173
SERVER_OA_LOGIN_URL=http://172.19.0.27/grgtapi/common-api
SERVER_SOAP_ENDPOINT=http://172.18.0.97:8003/Lab/Chemistry
SERVER_LOCAL_ADMIN=
SERVER_LOCAL_ADMIN_PASSWORD=

# 外部接口公共参数
AUTH_APP_ID=chemistry
AUTH_PWD_HASH=sha1
AUTH_TIMEOUT_MS=10000
DELIVERY_TARGET_NAMESPACE=http://tempuri.org/
DELIVERY_METHOD=AcceptReportFromDiGui
DELIVERY_PARAM_ID_NAME=sysNumber
DELIVERY_PARAM_FILE_NAME=file
DELIVERY_PARAM_JOBNO_NAME=jobNo
DELIVERY_SOAP_ACTION=http://tempuri.org/IChemistryService/AcceptReportFromDiGui
DELIVERY_CANCEL_METHOD=CancelFlowFromDiGui
DELIVERY_CANCEL_PARAM_ID_NAME=sysNumber
DELIVERY_CANCEL_PARAM_JOBNO_NAME=jobNo
DELIVERY_CANCEL_SOAP_ACTION=http://tempuri.org/IChemistryService/CancelFlowFromDiGui
DELIVERY_TASK_STATE_METHOD=UpdateMaterialTaskState
DELIVERY_TASK_STATE_PARAM_ID_NAME=taskId
DELIVERY_TASK_STATE_PARAM_STATE_NAME=testState
DELIVERY_TASK_STATE_SOAP_ACTION=http://tempuri.org/IChemistryService/UpdateMaterialTaskState
DELIVERY_SOAP_VERSION=1.1
DELIVERY_TIMEOUT_MS=30000

# PDF 和服务运行参数
TYPST_MAX_CONCURRENCY=2
TYPST_MAX_QUEUE=40
TYPST_QUEUE_TIMEOUT_MS=15000
TYPST_MEMORY_CACHE_MB=128
TYPST_DISK_CACHE_MB=2048
TYPST_CACHE_MAX_FILES=2000
SHUTDOWN_TIMEOUT_MS=60000
