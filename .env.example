# 环境变量（优先级最高，覆盖 config/*.json）
# 复制此文件为 .env 并填入实际值

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=cdr_demo
DB_USER=trish
DB_PASSWORD=

TYPST_BINARY=typst

# 超过 1 MB 的 PDF 自动检查重复图片/字体流并压缩；Ghostscript 命令默认是 gs。
# PDF_OPTIMIZE_MIN_BYTES=1048576
# PDF_OPTIMIZER_BINARY=gs
# PDF_OPTIMIZE_DISABLED=0

# 上传文件(图片/Excel附件)存储根目录。留空=【项目目录的上一级】/data(已在代码目录之外)。
# 想换到别处(如数据盘 /data)才填绝对路径(也可改 config/storage.local.json)。
STORAGE_UPLOADS_DIR=
# PDF 中的模板附件下载链接所使用的外部访问地址；生产环境请填实际 HTTPS 域名，如 https://reports.example.com
PUBLIC_BASE_URL=
